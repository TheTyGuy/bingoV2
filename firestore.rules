rules_version = '2';

// Players sign in anonymously. Anyone in a game can update the shared game
// document (prompts, votes, phase), but each player document can only be
// written by that player, or deleted by the host.
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.code == code;
      allow update: if request.auth != null
        && request.resource.data.code == resource.data.code
        && request.resource.data.prompts.size() <= 200;
      allow delete: if false;

      match /players/{playerId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == playerId
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 20;
        allow delete: if request.auth != null && (
          request.auth.uid == playerId
          || get(/databases/$(database)/documents/games/$(code)).data.hostId == request.auth.uid
        );
      }
    }
  }
}
